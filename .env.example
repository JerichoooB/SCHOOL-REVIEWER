# Server-only. Set actual values privately in Vercel Settings > Environment Variables.
# Never prefix these names with VITE_ or commit a populated .env file.
GEMINI_API_KEY=
# Choose your own random private passcode, 16–512 characters. Enter it in the quiz page.
RECALL_QUIZ_ACCESS_CODE=
# Optional: choose an available Gemini model. Free quotas/availability vary.
RECALL_AI_MODEL=gemini-2.5-flash-lite
